#!/bin/sh /etc/rc.common
# Sparrows-Network tree: Nomad Network page node (the Sparrows page), as user rns.
# It uses the rnsd started just before it (shared instance).
# Its config comes from the image (/etc/nomadnetwork/config); its name and extra pages from the owner
# (own/name and own/pages/, next to its identity). Its identity: /etc/nomadnetwork/storage,
# or /home/nomadnetwork on a Pi whose locked /home is set up. While /home is locked it waits:
# sparrows-unlock opens /home and starts it.

START=96
STOP=09
USE_PROCD=1

start_service() {
	local D=/etc/nomadnetwork
	if [ -x /usr/sbin/sparrows-home ]; then
		D=$(/usr/sbin/sparrows-home dir nomadnetwork) || { logger -t sparrows "nomadnet waits for /home: sparrows-unlock"; return 0; }
	fi
	if [ "$D" != /etc/nomadnetwork ]; then
		cp /etc/nomadnetwork/config "$D/config"     # the image's config, each start
	fi
	# The pages it serves: the image's (the Sparrows page), then the owner's on top, from own/pages
	# next to the identity: inside the locked /home on a Pi that has one (encrypted, kept when the
	# card's system is rewritten), else /etc/nomadnetwork/own (kept on update). Same name: the owner's wins
	local OWN="$D/own" LIVE="$D/pages" NAME
	rm -rf "$LIVE" && mkdir -p "$LIVE" && cp -a /usr/share/sparrows/nomadnet/pages/. "$LIVE/"
	[ ! -d "$OWN/pages" ] || cp -a "$OWN/pages/." "$LIVE/"
	# Its name in the announces: own/name (one line), else the Sparrows one
	NAME="Sparrows-Network ($(uci -q get system.@system[0].hostname))"
	[ ! -s "$OWN/name" ] || NAME=$(head -n 1 "$OWN/name" | tr -d '\r|&\\' | cut -c1-64)
	sed -i -e "s|^  node_name = .*|  node_name = $NAME|" -e "s|^  pages_path = .*|  pages_path = $LIVE|" "$D/config"
	chown -R rns:rns "$D/config" "$LIVE"
	procd_open_instance
	procd_set_param env PYTHONPATH=/usr/lib/sparrows/python HOME="$D"
	procd_set_param command /usr/bin/python3 -m nomadnet.nomadnet --daemon \
		--config "$D" --rnsconfig /etc/reticulum
	procd_set_param user rns
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
